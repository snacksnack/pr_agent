# PR Review Agent — environment configuration
# Copy this file to .env and fill in the values. Never commit your real .env.

# --- Required for the local dry-run (RC1-107 / RC1-113) ---
# Anthropic API key for the review agent loop.
ANTHROPIC_API_KEY=

# GitHub personal access token (read-only scope is fine). Used only by the
# dry-run CLI to fetch PR diffs/metadata. The live App uses installation
# tokens instead (RC1-115) and does NOT need this.
GITHUB_TOKEN=

# --- Review behavior (sensible defaults; override only if you want to) ---
# Workhorse model for reviews.
REVIEW_MODEL=claude-sonnet-4-6
# Optional deeper model for a second-pass review.
DEEP_REVIEW_MODEL=claude-opus-4-6
# Comma-separated finding categories that escalate the verdict to
# "Request changes". Everything else stays advisory (a plain Comment).
# Empty = purely advisory, never blocks.
REVIEW_BLOCK_ON=leaked_secret
# Comma-separated PR author logins the webhook acknowledges but never reviews
# (RC1-359). Each review is a billed model call; Dependabot version bumps arrive
# in bursts and carry nothing to judge. Empty = review every PR.
REVIEW_SKIP_AUTHORS=dependabot[bot]
# Guardrails for the agentic loop (cost / runtime).
MAX_TOOL_TURNS=20
MAX_FILES_READ=40
LOG_LEVEL=INFO
# Total GitHub API attempts per request before giving up (1 = no retry).
# Transient failures (5xx / rate limit / dropped connection) back off between
# attempts (RC1-120).
GITHUB_MAX_ATTEMPTS=4

# --- Live GitHub App (RC1-115 / RC1-116). Leave blank for the dry-run. ---
# The App's numeric ID (Settings -> Developer settings -> GitHub Apps).
# GITHUB_APP_ID=
# The App's PEM private key. Either paste it inline with literal "\n" escapes
# (one line) or point your process manager at the file's contents; both forms
# are accepted (RC1-115 normalizes escaped newlines).
# GITHUB_APP_PRIVATE_KEY=
# Shared secret used to verify webhook signatures (RC1-116).
# GITHUB_WEBHOOK_SECRET=
